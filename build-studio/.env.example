# Names only. Copy to .env (gitignored) and fill in. Never commit real values.

# --- Studio API (port 8020; serves the console too) ---
API_PORT=8020
DB_PATH=
WORKSPACES_DIR=
RUNNER_URL=http://127.0.0.1:8021
# Shared secret between API and runner. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
RUNNER_SHARED_TOKEN=
POLL_INTERVAL_SECONDS=5
RUN_TIMEOUT_SECONDS=1200
MAX_REQUIREMENT_CHARS=8000

# --- Agent Runner (port 8021, 127.0.0.1 only). The ONLY process that reads the PAT. ---
# live | fake  (fake = recorded fixtures, no GitHub calls)
RUNNER_MODE=live
# Fine-grained PAT, shared POC repo only: Agent tasks RW, Contents RW, Pull requests RW, Metadata R
GITHUB_COPILOT_PAT=
# owner/name of the shared private POC repo
GITHUB_REPO=
COPILOT_MODEL=claude-sonnet-4.6
COPILOT_CUSTOM_AGENT=brd
